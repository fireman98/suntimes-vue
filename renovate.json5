{
  extends: [
    'config:recommended',
  ],
  prConcurrentLimit: 4,
  schedule: [
    'on thursday',
  ],
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'minor and patch dependencies',
    },
    {
      matchUpdateTypes: [
        'security',
      ],
      minimumReleaseAge: '0 days',
    },
    {
      groupName: '0 day packages',
      matchPackageNames: ['msw'],
      minimumReleaseAge: '0 days',
    },
  ],
}
